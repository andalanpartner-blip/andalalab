    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "reality-check": "tsx scripts/reality-check.ts",
    "evaluate:briefs": "tsx scripts/evaluate-briefs.ts",
    "check": "pnpm validate:data && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/parser": "8.21.0",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
